go 1.26.0

// Ritual: this workspace file enumerates every Go module family owns in this
// repo. It starts empty because Phase 0 (this bootstrap) migrates no family —
// taxus is the seed lane that adds the first `<family>/go.mod` and, in the
// same change, an entry below.
//
// Keep this file in lockstep with what actually exists on disk:
//   - Adding `<family>/go.mod`? Add `./<family>` to the use block below.
//   - Archiving/removing a family's Go module? Remove its line here too.
// A go.work line pointing at a directory with no go.mod breaks `go` for
// everyone at the repo root, not just for that family.
//
// See spec/features/ext-contracts-monorepo/README.md (sneat-co/sneat-libs)
// — Decisions: "Go contract halves, option (b), full polyglot consolidation"
// — for why this is a multi-module (one go.mod per extension) layout rather
// than a single root module.
use (
	./bookius
	./gameboard
	./eventius
	./trackus
	./schoolus
	./kids-club
	./sneat-team
)
