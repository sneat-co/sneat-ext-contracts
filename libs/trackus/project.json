{
  "name": "trackus-contract",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/trackus/src",
  "projectType": "library",
  "tags": ["family:trackus", "layer:contract"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "libs/trackus/ng-package.json",
        "tsConfig": "libs/trackus/tsconfig.lib.json"
      },
      "configurations": {
        "production": { "tsConfig": "libs/trackus/tsconfig.lib.prod.json" }
      },
      "defaultConfiguration": "production"
    },
    "test": {
      "executor": "@nx/vitest:vitest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"]
    },
    "nx-release-publish": {
      "options": { "packageRoot": "dist/{projectRoot}" }
    }
  }
}
