{
  "name": "commitius-contract",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/commitius/src",
  "projectType": "library",
  "tags": ["family:commitius", "layer:contract"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "libs/commitius/ng-package.json",
        "tsConfig": "libs/commitius/tsconfig.lib.json"
      },
      "configurations": {
        "production": { "tsConfig": "libs/commitius/tsconfig.lib.prod.json" }
      },
      "defaultConfiguration": "production"
    },
    "nx-release-publish": {
      "options": { "packageRoot": "dist/{projectRoot}" }
    }
  }
}
