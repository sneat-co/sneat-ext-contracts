{
  "name": "rsvp-express-contract",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/rsvp-express/src",
  "projectType": "library",
  "tags": ["family:rsvp-express", "layer:contract"],
  "targets": {
    "test": {
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "config": "./vitest.config.mts",
        "passWithNoTests": true
      },
      "configurations": {
        "ci": { "update": false, "run": true, "coverage": true }
      }
    },
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "libs/rsvp-express/ng-package.json",
        "tsConfig": "libs/rsvp-express/tsconfig.lib.json"
      },
      "configurations": {
        "production": { "tsConfig": "libs/rsvp-express/tsconfig.lib.prod.json" }
      },
      "defaultConfiguration": "production"
    },
    "nx-release-publish": {
      "options": { "packageRoot": "dist/{projectRoot}" }
    }
  }
}
