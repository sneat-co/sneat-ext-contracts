{
  "name": "bookius-contract",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/bookius/src",
  "projectType": "library",
  "tags": ["family:bookius", "layer:contract"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "libs/bookius/ng-package.json",
        "tsConfig": "libs/bookius/tsconfig.lib.json"
      },
      "configurations": {
        "production": { "tsConfig": "libs/bookius/tsconfig.lib.prod.json" }
      },
      "defaultConfiguration": "production"
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "cwd": "libs/bookius",
        "command": "vitest run"
      }
    },
    "nx-release-publish": {
      "options": { "packageRoot": "dist/{projectRoot}" }
    }
  }
}
