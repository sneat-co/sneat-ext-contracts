{
  "name": "gameboard-contract",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/gameboard/src",
  "projectType": "library",
  "tags": ["family:gameboard", "layer:contract"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "libs/gameboard/ng-package.json",
        "tsConfig": "libs/gameboard/tsconfig.lib.json"
      },
      "configurations": {
        "production": { "tsConfig": "libs/gameboard/tsconfig.lib.prod.json" }
      },
      "defaultConfiguration": "production"
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": { "cwd": "libs/gameboard", "command": "vitest run" }
    },
    "nx-release-publish": {
      "options": { "packageRoot": "dist/{projectRoot}" }
    }
  }
}
