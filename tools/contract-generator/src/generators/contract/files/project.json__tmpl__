{
  "name": "<%= projectName %>",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/<%= family %>/src",
  "projectType": "library",
  "tags": ["family:<%= family %>", "layer:contract"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "libs/<%= family %>/ng-package.json",
        "tsConfig": "libs/<%= family %>/tsconfig.lib.json"
      },
      "configurations": {
        "production": { "tsConfig": "libs/<%= family %>/tsconfig.lib.prod.json" }
      },
      "defaultConfiguration": "production"
    },
    "nx-release-publish": {
      "options": { "packageRoot": "dist/{projectRoot}" }
    }
  }
}
